{
  "$schema": "../../schemas/installer-manifest.schema.json",
  "id": "installer.ai-context",
  "name": "AI Context Lifecycle",
  "version": "1.2.8",
  "kind": "installer",
  "status": "stable",
  "consumers": [
    "shared"
  ],
  "supportedPlatforms": [
    "windows",
    "linux",
    "macos"
  ],
  "supportedProfiles": [
    "generic"
  ],
  "defaultProfile": "generic",
  "entrypoints": {
    "powershell": "install.ps1",
    "posix": "install.sh"
  },
  "verifiers": {
    "powershell": "verify.ps1",
    "posix": "verify.sh"
  },
  "uninstallers": {
    "powershell": "uninstall.ps1",
    "posix": "uninstall.sh"
  },
  "description": "Installs and maintains zero-touch project AI context lifecycle assets for member repositories and dedicated central context repositories on Windows, Linux, and macOS. POSIX hosts require Bash, Git, and Python 3.10+."
}
